#. translators: %s: link to the Init View Count plugin page.
#: includes/settings-page.php:330
#, php-format
msgid "This feature requires the %s plugin to be active on this site."
msgstr "Tính năng này yêu cầu plugin %s đang được kích hoạt trên site."

#: includes/settings-page.php:338
msgid "You can still configure the fields below now — they will start working automatically as soon as Init View Count is installed and activated, no need to re-save."
msgstr "Bạn vẫn có thể cấu hình các trường bên dưới ngay bây giờ — chúng sẽ tự động hoạt động ngay khi Init View Count được cài đặt và kích hoạt, không cần lưu lại."

#: includes/settings-page.php:346
msgid "Notify on View Milestones"
msgstr "Thông báo khi đạt mốc lượt xem"

#: includes/settings-page.php:353
msgid "Send a Discord notification when a tracked post's total view count (from Init View Count) crosses one of the milestones below."
msgstr "Gửi thông báo Discord khi tổng lượt xem (từ Init View Count) của bài viết đang theo dõi vượt qua 1 trong các mốc bên dưới."

#: includes/settings-page.php:356
msgid "Uses the same post types selected in \"Post Types\" above. Each milestone is only ever sent once per post."
msgstr "Dùng chung danh sách Post Types đã chọn ở trên. Mỗi mốc chỉ gửi thông báo đúng 1 lần cho mỗi bài viết."

#: includes/settings-page.php:362
msgid "View Milestones"
msgstr "Các mốc lượt xem"

#: includes/settings-page.php:370
msgid "Comma-separated view counts. A notification fires once when total views reach or pass each one, in ascending order."
msgstr "Danh sách số lượt xem, cách nhau bằng dấu phẩy. Thông báo sẽ gửi 1 lần khi tổng lượt xem đạt hoặc vượt mỗi mốc, theo thứ tự tăng dần."

#: includes/settings-page.php:376
msgid "Milestone Message Template"
msgstr "Mẫu tin nhắn cho mốc lượt xem"

#: includes/settings-page.php:384
msgid "Uses the same placeholders as the post template above, plus:"
msgstr "Dùng chung các placeholder với mẫu bài viết ở trên, kèm thêm:"

#: includes/settings-page.php:385
msgid "Current total views, formatted (e.g. 12,345)"
msgstr "Tổng lượt xem hiện tại, đã định dạng (VD: 12.345)"

#: includes/settings-page.php:386
msgid "Current total views, abbreviated (e.g. 12.3K)"
msgstr "Tổng lượt xem hiện tại, dạng rút gọn (VD: 12,3 N)"

#: includes/settings-page.php:387
msgid "The milestone that was just crossed"
msgstr "Mốc lượt xem vừa đạt được"

