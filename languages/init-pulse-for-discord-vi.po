msgid ""
msgstr ""
"Project-Id-Version: Init Discord Hub\n"
"Language: vi_VN\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Init Pulse For Discord"
msgstr "Init Pulse For Discord"

msgid "Send notifications to Discord via webhooks. Custom post types, rich embeds, test messages, and a delivery log."
msgstr "Gửi thông báo tới Discord qua webhook. Hỗ trợ custom post type, rich embed, tin nhắn thử và nhật ký gửi."

msgid "Settings"
msgstr "Cài đặt"

msgid "Discord Notifications"
msgstr "Thông báo Discord"

msgid "Enable Discord Notifications"
msgstr "Bật thông báo Discord"

msgid "Send notifications to Discord when content is published."
msgstr "Gửi thông báo đến Discord khi bài viết được đăng."

msgid "This page configures options only. Hook the actual sending into publish/update events."
msgstr "Trang này chỉ cấu hình cài đặt. Việc gửi thông báo sẽ được thực hiện khi có sự kiện đăng / cập nhật bài viết."

msgid "Events to Notify"
msgstr "Sự kiện để thông báo"

msgid "Notify On"
msgstr "Thông báo khi"

msgid "A tracked item is published"
msgstr "Một nội dung được theo dõi được đăng"

msgid "An existing item is updated (status remains publish)"
msgstr "Một nội dung đang đăng được cập nhật"

msgid "Applies to whichever post types are selected above."
msgstr "Áp dụng cho các loại nội dung đã chọn ở trên."

msgid "Webhook & Identity"
msgstr "Webhook & Danh tính"

msgid "Discord Webhook URL"
msgstr "Discord Webhook URL"

msgid "Paste the full webhook URL from your Discord channel."
msgstr "Dán URL webhook đầy đủ lấy từ kênh Discord của bạn."

msgid "Default Username"
msgstr "Tên mặc định"

msgid "Shown as the sender name (e.g., \"Init Bot\")."
msgstr "Hiển thị như tên người gửi (ví dụ: \"Init Bot\")."

msgid "Avatar URL"
msgstr "URL ảnh đại diện"

msgid "Public image URL used as the webhook avatar (optional)."
msgstr "URL ảnh đại diện cho webhook (không bắt buộc)."

msgid "Content & Media"
msgstr "Nội dung & Hình ảnh"

msgid "Include Featured Image"
msgstr "Đính kèm ảnh đại diện"

msgid "Attach the featured image to the Discord embed (if available)."
msgstr "Đính kèm ảnh đại diện của bài viết vào embed gửi Discord (nếu có)."

msgid "Image Size"
msgstr "Kích thước ảnh"

msgid "Message Template"
msgstr "Mẫu tin nhắn"

msgid "New/Updated Post Template"
msgstr "Mẫu thông báo bài viết mới / cập nhật"

msgid "Available placeholders:"
msgstr "Các placeholder có thể dùng:"

msgid "Post title"
msgstr "Tiêu đề bài viết"

msgid "Post title linked to URL"
msgstr "Tiêu đề bài viết (đính kèm liên kết)"

msgid "Post URL"
msgstr "URL bài viết"

msgid "Post excerpt (trimmed)"
msgstr "Tóm tắt bài viết"

msgid "Your site name"
msgstr "Tên website của bạn"

msgid "Reliability & Safety"
msgstr "Độ tin cậy & An toàn"

msgid "Request Timeout (seconds)"
msgstr "Thời gian chờ (giây)"

msgid "Retry Attempts"
msgstr "Số lần thử lại"

msgid "Discord Role ID"
msgstr "Discord Role ID"

msgid "Mention this role when notifying posts in this term."
msgstr "Nhắc role này khi gửi thông báo bài viết thuộc danh mục/thẻ này."

msgid "Enter Role ID for this term"
msgstr "Nhập Role ID cho danh mục/thẻ này"

msgid "Discord Role ID (all-posts role)"
msgstr "Discord Role ID (role toàn bộ bài viết)"

msgid "Enter Role ID for all-posts notifications (optional)"
msgstr "Nhập Role ID cho thông báo toàn bộ bài viết (tùy chọn)"

msgid "Optional broader role subscribed to all updates."
msgstr "Tùy chọn — role nhận mọi thông báo."
msgid "Post Types"
msgstr "Loại nội dung"

msgid "Notify These Post Types"
msgstr "Loại nội dung cần thông báo"

msgid "Choose which post types should trigger a Discord notification. Custom post types are supported."
msgstr "Chọn loại nội dung sẽ kích hoạt thông báo Discord. Hỗ trợ cả custom post type."

msgid "Send Test Message"
msgstr "Gửi tin nhắn thử"

msgid "Sending…"
msgstr "Đang gửi…"

msgid "Use Rich Embed"
msgstr "Dùng Rich Embed"

msgid "Send a formatted embed (title, description, color, footer) instead of plain text."
msgstr "Gửi embed có định dạng (tiêu đề, mô tả, màu sắc, footer) thay vì văn bản thuần."

msgid "When disabled, the plugin falls back to the plain-text format used before version 1.1."
msgstr "Khi tắt, plugin sẽ dùng định dạng văn bản thuần như trước phiên bản 1.1."

msgid "Embed Color"
msgstr "Màu Embed"

msgid "Accent color shown on the left edge of the embed."
msgstr "Màu nhấn hiển thị ở cạnh trái của embed."

msgid "Used as the embed description when Rich Embed is enabled, or as the full message otherwise."
msgstr "Dùng làm phần mô tả của embed khi bật Rich Embed, hoặc làm toàn bộ nội dung tin nhắn nếu tắt."

msgid "Post author display name"
msgstr "Tên hiển thị của tác giả"

msgid "Comma-separated category names"
msgstr "Danh sách tên danh mục, phân tách bằng dấu phẩy"

msgid "Comma-separated tag names"
msgstr "Danh sách tên thẻ, phân tách bằng dấu phẩy"

msgid "Post type label"
msgstr "Tên loại nội dung"

msgid "Published date (site format)"
msgstr "Ngày đăng (theo định dạng website)"

msgid "Delivery Log"
msgstr "Nhật ký gửi"

msgid "Shows the last %d webhook deliveries (newest first) for troubleshooting."
msgstr "Hiển thị %d lần gửi webhook gần nhất (mới nhất trước) để hỗ trợ khắc phục sự cố."

msgid "No deliveries yet."
msgstr "Chưa có lần gửi nào."

msgid "Time"
msgstr "Thời gian"

msgid "Item"
msgstr "Nội dung"

msgid "Status"
msgstr "Trạng thái"

msgid "Detail"
msgstr "Chi tiết"

msgid "Success"
msgstr "Thành công"

msgid "Error"
msgstr "Lỗi"

msgid "Clear Log"
msgstr "Xóa nhật ký"

msgid "Delivery log cleared."
msgstr "Đã xóa nhật ký gửi."

msgid "You are not allowed to do this."
msgstr "Bạn không có quyền thực hiện thao tác này."

msgid "Please enter a webhook URL first."
msgstr "Vui lòng nhập URL webhook trước."

msgid "This does not look like a valid Discord webhook URL."
msgstr "URL này có vẻ không phải webhook Discord hợp lệ."

msgid "Test message"
msgstr "Tin nhắn thử"

msgid "Init Pulse For Discord is correctly configured on %s."
msgstr "Init Pulse For Discord đã được cấu hình đúng trên %s."

msgid "✅ Test message from %s — Init Pulse For Discord is configured correctly."
msgstr "✅ Tin nhắn thử từ %s — Init Pulse For Discord đã được cấu hình đúng."

msgid "Delivered"
msgstr "Đã gửi"

msgid "Test message sent! Check your Discord channel."
msgstr "Đã gửi tin nhắn thử! Kiểm tra kênh Discord của bạn."

msgid "Discord webhook responded with HTTP %d."
msgstr "Webhook Discord phản hồi với mã HTTP %d."

msgid "Discord webhook unreachable after retries."
msgstr "Không thể kết nối webhook Discord sau nhiều lần thử lại."

msgid "New post"
msgstr "Bài viết mới"

msgid "Update"
msgstr "Cập nhật"

